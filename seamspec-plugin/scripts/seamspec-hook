#!/bin/sh
# SeamSpec hook wrapper (SPEC §16.1): exit quietly if the SeamSpec CLI isn't installed, so a
# teammate who has the plugin enabled but not the CLI never sees hook errors.
# Apps started from the Dock and GUI git clients often lack ~/.local/bin, where `uv tool` installs.
PATH="$PATH:$HOME/.local/bin"
command -v seamspec >/dev/null 2>&1 || exit 0
exec seamspec "$@"
