#!/bin/sh
# SeamSpec MCP wrapper (SPEC §16.1): explain a missing CLI instead of failing silently.
# Apps started from the Dock and GUI git clients often lack ~/.local/bin, where `uv tool` installs.
PATH="${PATH:+$PATH:}$HOME/.local/bin"  # never an empty entry (= current folder)
if ! command -v seamspec >/dev/null 2>&1; then
  echo "SeamSpec CLI not found on PATH. Install it:" >&2
  echo "  uv tool install seamspec" >&2
  echo "or, from a checkout: uv tool install --force --editable <path-to-seamspec-repo>" >&2
  exit 1
fi
exec seamspec mcp "$@"
